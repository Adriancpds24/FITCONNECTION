PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/fitconnect
JWT_SECRET=change_this_jwt_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@dominio.com
SMTP_PASS=tu-password-o-app-password
SMTP_FROM=FitConnect <tu-correo@dominio.com>

# Enlace WEB (Flutter web / navegador)
PASSWORD_RESET_URL=https://fitconnection-production.up.railway.app/reset-password
# Enlace APP movil (deep link iOS/Android) — opcional pero recomendado
PASSWORD_RESET_APP_URL=fitconnect://reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# AI (server-side)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
AI_PROVIDER=

# OAuth (Google / Apple) — ver `lib/core/config/oauth_config.dart` y README del API
# Cliente OAuth tipo "Web" de Google Cloud (varios IDs separados por coma)
GOOGLE_OAUTH_CLIENT_IDS=
# Alias opcional de un solo ID web
GOOGLE_WEB_CLIENT_ID=
# Bundle ID(s) de iOS/macOS para validar el JWT de Apple (coma para varios)
APPLE_SIGN_IN_AUDIENCES=com.fitconnect.rms
